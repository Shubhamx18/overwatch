# 🔐 Environment Variables — DO NOT COMMIT THIS FILE
# Copy this file to .env and fill in your values

# Alertmanager - SMTP Email
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=prometheus@yourdomain.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Alertmanager - Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Alert destination email
ALERT_EMAIL_TO=oncall@yourdomain.com

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy

# AWS (for Terraform deployment)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-west-2
